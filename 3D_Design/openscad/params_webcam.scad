// ============================================================================
// Custom Disassembled Webcam Enclosure for MG90S Gimbal Axis - Parameters
// صندوق كاميرا الويب المخصص لمحور MG90S - ملف المتغيرات القابل للتعديل
// ============================================================================
$fn = 64;

// --- 1. أبعاد لوحة الكاميرا والعدسة (من قياساتك الفعلية بالكاليبر) ---
pcb_w           = 30.0;  // عرض اللوحة الإلكترونية (مم)
pcb_h           = 25.0;  // ارتفاع اللوحة الإلكترونية (مم)
pcb_thk         = 1.6;   // سماكة اللوحة
pcb_hole_dx     = 24.0;  // المسافة بين ثقوب التثبيت عرضياً (مم)
pcb_hole_dz     = 23.0;  // المسافة بين ثقوب التثبيت طولياً (مم)
pcb_pilot_d     = 1.85;  // قطر ثقب التسنين الذاتي لبراغي الكاميرا الصغيرة / M2

lens_cyl_d      = 23.0;  // قطر الأسطوانة الفضية الدوارة (مم)
lens_hole_clear = 1.0;   // سماحية الدوران (الفتحة = 24.0 مم: تمرر 23 مم وتحبس الشفة 25 مم!)
lens_flange_d   = 25.0;  // قطر الشفة البارزة خلف الأسطوانة (مم)
lens_flange_t   = 1.5;   // سماكة الشفة
focus_min       = 8.0;   // أقرب مسافة للشفة عن اللوحة (فوكس بعيد للدرون)
focus_max       = 13.0;  // أبعد مسافة للشفة عن اللوحة (فوكس قريب)
lens_offset_y   = 0.0;   // إزاحة العدسة أفقياً عن مركز اللوحة (عدّلها إن لزم)
lens_offset_z   = 0.0;   // إزاحة العدسة عمودياً عن مركز اللوحة (عدّلها إن لزم)

// --- 2. أبعاد الصندوق والغلاف ---
pcb_clear       = 0.8;   // سماحية داخلية حول اللوحة
wall_side       = 2.5;   // سماكة الجدران العادية
wall_servo      = 3.6;   // سماكة الجدار الأيمن الحامل لتجويف ذراع MG90S
wall_front      = 2.0;   // سماكة الوجه الأمامي (رقيقة لراحة تدوير الأسطوانة بالأصابع)
wall_rear       = 2.0;   // سماكة الغطاء الخلفي
front_chamber   = 14.8;  // عمق الحجرة الأمامية (>= focus_max + lens_flange_t = 14.5 مم)
rear_chamber    = 8.5;   // عمق الحجرة الخلفية للأسلاك واللحام (وراء سطح اللوحة الأمامي)
cable_d         = 5.2;   // فتحة خروج كابل الـ USB من الجانب (-Y)
lid_tol         = 0.25;  // سماحية تداخل شفة الغطاء الخلفي

// --- 3. ربط الصندوق المباشر بمحور محرك MG90S (بديل مباشر للقطعة 05 في الغيمبال) ---
y_shift          = -1.0; // إزاحة -1 مم لتطابق أرضية تجويف ذراع MG90S تماماً مع Y=+16.5 في القطعة 04
x_tilt_rel_pcb   = 3.5;  // موقع محور MG90S بالنسبة لوجه اللوحة الأمامي (عند مركز الثقل)
mg90_horn_recess = 1.5;  // عمق تجويف احتضان ذراع MG90S البلاستيكي
mg90_horn_hub_d  = 6.6;  // قطر تجويف مركز الذراع
mg90_horn_slot_w = 4.4;  // عرض شق الذراع المزدوج
mg90_horn_slot_l = 24.0; // طول شق الذراع المزدوج
mg90_center_d    = 4.8;  // فتحة برغي محور السيرفو
mg90_screw_d     = 1.8;  // ثقوب تثبيت الذراع (M1.6 / M2)

// --- قيم محسوبة تلقائياً ---
in_w        = pcb_w + pcb_clear;
in_h        = pcb_h + pcb_clear;
in_y0       = y_shift - in_w/2;
in_y1       = y_shift + in_w/2;
out_y0      = in_y0 - wall_side;
out_y1      = in_y1 + wall_servo;
in_z0       = -in_h/2;
in_z1       = +in_h/2;
out_z0      = in_z0 - wall_side;
out_z1      = in_z1 + wall_side;
x_front_in  = front_chamber;
x_front_out = x_front_in + wall_front;
x_rear_in   = -rear_chamber;
x_rear_out  = x_rear_in - wall_rear;
x_lid_screw = x_rear_in + 3.2;
